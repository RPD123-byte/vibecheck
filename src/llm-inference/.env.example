# Server-only. Never package these values into Electron.
GEMINI_API_KEY=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Required by Trigger.dev deployment and invocation tooling.
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Opt in to the live Gemini smoke test only when explicitly desired.
RUN_GEMINI_LIVE_TEST=0
