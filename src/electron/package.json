{
  "name": "@vibecheck/menubar",
  "productName": "Vibecheck",
  "version": "0.2.1",
  "description": "Private on-device expression controls for Vibecheck",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package --arch=arm64",
    "make": "electron-forge make --arch=arm64",
    "format": "prettier --write \"src/**/*.ts\" \"e2e/**/*.ts\" \"*.ts\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"e2e/**/*.ts\" \"*.ts\" \"*.json\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-forge package --arch=arm64 && playwright test --config playwright.config.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/notarize": "3.1.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.1",
    "electron": "43.2.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
